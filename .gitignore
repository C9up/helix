node_modules/
target/
# …including when it is a symlink pointing the build output elsewhere,
# which `target/` does not match.
target
dist/
/coverage/
*.node
# The publish job copies the licence into each platform package it publishes.
npm/*/LICENSE
.env
.env.local
.DS_Store
*.log
# Package archives (`npm pack` output, a downloaded upstream tarball): never source.
*.tgz
.turbo/

# Throwaway fixtures used to verify a change by hand — never source.
.tmp-*/
# Workstream: the maintainer's local tracking, never published
.workstream/
